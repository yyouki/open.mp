+// Clone the full GTA CVehicleModelInfo and install its clump through VMT slot 16.
+static BOOL GameRegisterCustomVehicle(int base, int model, const char* name, const char* dff, const char* txd)
+{
+    if (base < 400 || base > 611 || model < 30001 || model > 32767 || !g_gameModelInfoTable)
+        return FALSE;
+    void* source = g_gameModelInfoTable[base];
+    if (!source || g_gameModelInfoTable[model])
+        return FALSE;
+    void* info = calloc(1, 0x308);
+    if (!info)
+        return FALSE;
+    memcpy(info, source, 0x308);
+    g_gameModelInfoTable[model] = info;
+    if (!GameAttachModelTxd(model, name, txd))
+        return FALSE;
+    g_gameLoadingCustomModel = model;
+    void* clump = GameLoadPedDff(dff);
+    if (!clump)
+        return FALSE;
+    *(void**)((BYTE*)info + 0x1c) = clump;
+    ((void(__fastcall*)(void*, void*, void*))(*(DWORD**)info)[16])(info, 0, clump);
+    return TRUE;
+}
