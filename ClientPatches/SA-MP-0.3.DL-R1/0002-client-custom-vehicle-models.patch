+// 0x0000ccf0 (new extension)
+bool CCustomModels::IsVehicleEntry(int model)
+{
+    if (model < 30001 || model > 32767)
+        return false;
+    DWORD count = GetCount();
+    for (DWORD i = 0; i < count; ++i)
+    {
+        BYTE* entry = (BYTE*)GetRecord(i);
+        if (entry && entry[7] == 3 && *(int*)(entry + 0x10) == model)
+            return true;
+    }
+    return false;
+}
+
+// Returns the base GTA vehicle ID for a registered custom vehicle.
+BOOL CCustomModels::GetVehicleBaseModel(int model, DWORD* base)
+{
+    if (!base || model < 30001 || model > 32767)
+        return FALSE;
+    DWORD count = GetCount();
+    for (DWORD i = 0; i < count; ++i)
+    {
+        BYTE* entry = (BYTE*)GetRecord(i);
+        if (entry && entry[7] == 3 && *(int*)(entry + 0x10) == model)
+        {
+            *base = *(DWORD*)(entry + 0xc);
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+// 0 = assets still downloading, 1 = GTA model registered, -1 = permanent failure.
+int CCustomModels::LoadVehicleEntry(int model)
+{
+    if (model < 30001 || model > 32767)
+        return CUSTOM_VEHICLE_FAILED;
+    DWORD count = GetCount();
+    for (DWORD i = 0; i < count; ++i)
+    {
+        BYTE* entry = (BYTE*)GetRecord(i);
+        if (!entry || entry[7] != 3 || *(int*)(entry + 0x10) != model)
+            continue;
+        if (entry[0x5e] == 1)
+            return CUSTOM_VEHICLE_READY;
+        if (entry[0x5e] == 2)
+            return CUSTOM_VEHICLE_FAILED;
+        if (!entry[0] || !entry[1])
+            return CUSTOM_VEHICLE_PENDING;
+        if (LoadVehicleModel(*(DWORD*)(entry + 0xc), *(DWORD*)(entry + 0x10),
+                             *(DWORD*)(entry + 0x46), *(DWORD*)(entry + 0x4a)))
+        {
+            entry[0x5e] = 1;
+            entry[0x58] = 1;
+            entry[0x59] = 0;
+            return CUSTOM_VEHICLE_READY;
+        }
+        entry[0x5e] = 2;
+        return CUSTOM_VEHICLE_FAILED;
+    }
+    return CUSTOM_VEHICLE_FAILED;
+}
