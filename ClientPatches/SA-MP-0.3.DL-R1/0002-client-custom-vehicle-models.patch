 // Custom vehicle queue entries retain their original tuning bytes until loaded.
 void CVehiclePool::QueueCustomVehicle(const VehiclePoolQueueEntry* entry, const BYTE* tuning)
 {
+    if (!entry || !tuning || entry->id >= 2000 || entry->model < 30001 || entry->model > 32767)
+        return;
+    int slot = -1;
+    for (int i = 0; i < 100; ++i)
+    {
+        if (queueActive[i] && queue[i].id == entry->id)
+        {
+            slot = i;
+            break;
+        }
+    }
+    if (slot < 0)
+    {
+        for (int i = 0; i < 100; ++i)
+        {
+            if (!queueActive[i])
+            {
+                slot = i;
+                break;
+            }
+        }
+    }
+    if (slot < 0)
+    {
+        g_pChat->AddDebugMessage(g_vehiclePoolQueueFullMessage);
+        return;
+    }
+    queue[slot] = *entry;
+    queueActive[slot] = 1;
+    memcpy(g_customVehicleQueueTuning[slot], tuning, 23);
+    g_customVehicleQueueHasTuning[slot] = 1;
+}
+#endif // DL_BUILD
 
