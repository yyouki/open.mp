From 7b8f4d5e6a1c2d3e4f5061728394a5b6c7d8e9f0 Mon Sep 17 00:00:00 2001
From: open.mp custom vehicle integration
Subject: [PATCH 1/1] DL client: harden model records and vehicle pool bounds

Target baseline:
1therealcloud/samp
118956c2e6c67527395dce47f3e655fad4352a12

This preparatory patch does not add model type 3 and does not advertise RPC
186. It hardens the existing 0.3.DL client paths before the custom-vehicle
implementation is applied.

---
diff --git a/source/game/custommodels.cpp b/source/game/custommodels.cpp
--- a/source/game/custommodels.cpp
+++ b/source/game/custommodels.cpp
@@ -385,8 +385,18 @@ DWORD CCustomModels::ParseCacheHash(const char* filename)
 {
     if (filename[0] != '0' || filename[1] != 'x')
         return 0;
-    char digits[12];
-    strncpy(digits, filename + 2, 8);
-    return strtoul(digits, 0, 16);
+    char digits[9];
+    for (int i = 0; i < 8; ++i)
+    {
+        const char value = filename[i + 2];
+        if (!((value >= '0' && value <= '9') || (value >= 'a' && value <= 'f') || (value >= 'A' && value <= 'F')))
+            return 0;
+        digits[i] = value;
+    }
+    digits[8] = '\0';
+    char* end = 0;
+    unsigned long value = strtoul(digits, &end, 16);
+    if (end != digits + 8)
+        return 0;
+    return (DWORD)value;
 }
@@ -498,10 +508,19 @@ DWORD CCustomModels::AddRecord(DWORD index, const void* record)
 {
-    void* copy = calloc(1, 94);
+    if (!record || index > GetCount() || GetRecord(index))
+        return 0xffffffff;
+    BYTE type = ((const BYTE*)record)[7];
     int base = *(const int*)((const BYTE*)record + 0xc);
-    if (base < 0 || base > 20000)
+    if ((type != 1 && type != 2) || base < 0 || base > 20000)
         return 0xffffffff;
+    void* copy = calloc(1, 94);
+    if (!copy)
+        return 0xffffffff;
     memcpy(copy, record, 94);
-    SetRecord(index, copy);
+    if (!SetRecord(index, copy))
+    {
+        free(copy);
+        return 0xffffffff;
+    }
     return index;
 }
diff --git a/source/game/custommodels.h b/source/game/custommodels.h
--- a/source/game/custommodels.h
+++ b/source/game/custommodels.h
@@ -131,1 +131,1 @@
-    // Eight copied digits are deliberately not explicitly terminated.
+    // Parses exactly eight hexadecimal digits from a cache filename.
@@ -160,1 +160,1 @@
-    // Allocates before validation; invalid base IDs deliberately leak that allocation.
+    // Validates before allocation and frees the copy if insertion fails.
diff --git a/source/net/netrpc.cpp b/source/net/netrpc.cpp
--- a/source/net/netrpc.cpp
+++ b/source/net/netrpc.cpp
@@ -181,28 +181,35 @@ void ScrCustomModelRecord(RPCParameters* parameters)
 {
+    // 8-byte index/count header + 31-byte model record.
+    if (!parameters || parameters->numberOfBitsOfData != 39 * 8)
+        return;
     RakNet::BitStream stream(parameters->input, (int)parameters->numberOfBitsOfData / 8 + 1, false);
     BYTE record[94] = {0};
     DWORD index = 0, count = 0;
-    if (!g_customModels)
-    {
-        CCustomModels* models = new CCustomModels;
-        g_customModels = models;
-        models->Initialize();
-        if (!g_customModels)
-            return;
-    }
-    stream.ReadBits((BYTE*)&index, 32, true);
-    stream.ReadBits((BYTE*)&count, 32, true);
-    stream.ReadBits(record + 7, 8, true);
-    stream.ReadBits(record + 8, 32, true);
-    stream.ReadBits(record + 0xc, 32, true);
-    stream.ReadBits(record + 0x10, 32, true);
-    stream.ReadBits(record + 0x46, 32, true);
-    stream.ReadBits(record + 0x4a, 32, true);
-    stream.ReadBits(record + 0x4e, 32, true);
-    stream.ReadBits(record + 0x52, 32, true);
-    stream.ReadBits(record + 0x56, 8, true);
-    stream.ReadBits(record + 0x57, 8, true);
-    g_customModels->AddRecord(index, record);
+    if (!stream.ReadBits((BYTE*)&index, 32, true) ||
+        !stream.ReadBits((BYTE*)&count, 32, true) ||
+        !stream.ReadBits(record + 7, 8, true) ||
+        !stream.ReadBits(record + 8, 32, true) ||
+        !stream.ReadBits(record + 0xc, 32, true) ||
+        !stream.ReadBits(record + 0x10, 32, true) ||
+        !stream.ReadBits(record + 0x46, 32, true) ||
+        !stream.ReadBits(record + 0x4a, 32, true) ||
+        !stream.ReadBits(record + 0x4e, 32, true) ||
+        !stream.ReadBits(record + 0x52, 32, true) ||
+        !stream.ReadBits(record + 0x56, 8, true) ||
+        !stream.ReadBits(record + 0x57, 8, true))
+        return;
+    if (!count || index >= count || (record[7] != 1 && record[7] != 2))
+        return;
+    if (!g_customModels)
+    {
+        g_customModels = new CCustomModels;
+        if (!g_customModels)
+            return;
+        g_customModels->Initialize();
+    }
+    if (g_customModels->AddRecord(index, record) != index)
+        return;
     g_customModels->SetExpectedRecordCount(count);
 }
diff --git a/source/net/netrpc.cpp b/source/net/netrpc.cpp
--- a/source/net/netrpc.cpp
+++ b/source/net/netrpc.cpp
@@ -360,3 +360,5 @@ void ScrWorldVehicleAdd(RPCParameters* parameters)
 {
+    if (!parameters || parameters->numberOfBitsOfData != 63 * 8)
+        return;
     RakNet::BitStream stream(parameters->input, (int)parameters->numberOfBitsOfData / 8 + 1, false);
@@ -369,2 +371,2 @@ void ScrWorldVehicleAdd(RPCParameters* parameters)
-    stream.Read((char*)&entry, 40);
-    stream.Read((char*)tuning, 23);
+    if (!stream.Read((char*)&entry, 40) || !stream.Read((char*)tuning, 23))
+        return;
@@ -372,3 +374,4 @@ void ScrWorldVehicleAdd(RPCParameters* parameters)
     if (entry.model < 400 || entry.model > 611)
         return;
-    pool->Create(&entry);
+    if (entry.id >= 2000 || !pool->Create(&entry))
+        return;
     CVehicle* vehicle = pool->Get(entry.id);
@@ -402,4 +405,6 @@ void ScrWorldVehicleRemove(RPCParameters* parameters)
 void ScrWorldVehicleRemove(RPCParameters* parameters)
 {
+    if (!parameters || parameters->numberOfBitsOfData != 16)
+        return;
     CVehiclePool* vehicles = ((CNetGame*)g_pNetGame)->pools->vehicles;
     RakNet::BitStream stream(parameters->input, (int)parameters->numberOfBitsOfData / 8 + 1, false);
@@ -409,2 +414,2 @@ void ScrWorldVehicleRemove(RPCParameters* parameters)
     WORD id;
-    stream.Read(id);
+    if (!stream.Read(id))
+        return;
diff --git a/source/net/vehiclepool.cpp b/source/net/vehiclepool.cpp
--- a/source/net/vehiclepool.cpp
+++ b/source/net/vehiclepool.cpp
@@ -26,4 +26,6 @@ void CVehiclePool::SetUnoccupiedSyncOwner(WORD vehicle, WORD player)
 {
+    if (vehicle >= 2000)
+        return;
     *(WORD*)((BYTE*)this + 0x8e34 + vehicle * 2) = player;
 }
@@ -91,4 +93,5 @@ void CVehiclePool::Process()
 {
+    ProcessWaitingList();
     DWORD now = GetTickCount();
     CLocalPlayer* local = ((CNetGame*)g_pNetGame)->pools->players->local;
@@ -182,4 +185,6 @@ BOOL CVehiclePool::Create(const VehiclePoolQueueEntry* entry)
 {
+    if (!entry || entry->id >= 2000 || entry->model < 400 || entry->model > 611)
+        return FALSE;
     if (m_pObjects[entry->id])
     {
@@ -308,5 +313,5 @@ void CVehiclePool::ChangeInterior(WORD id, int interior)
 {
-    if (m_bNotEmpty[id])
+    if (id < 2000 && m_bNotEmpty[id])
         m_pObjects[id]->ChangeInterior(interior);
 }
@@ -426,4 +431,4 @@ DWORD CVehiclePool::GetRef(int id)
 {
-    return m_pGameObjects[id] ? GamePoolVehicleGetIndex(m_pGameObjects[id]) : 0xffff;
+    return id >= 0 && id < 2000 && m_pGameObjects[id] ? GamePoolVehicleGetIndex(m_pGameObjects[id]) : 0xffff;
 }
diff --git a/source/game/game.cpp b/source/game/game.cpp
--- a/source/game/game.cpp
+++ b/source/game/game.cpp
@@ -707,4 +707,6 @@ CVehicle* CGame::CreateVehicle(int model, float x, float y, float z, float rotation, BOOL siren)
 {
     // Native indexes this+model-0x122 without a model-range check.
+    if (model < 400 || model > 611)
+        return 0;
     DWORD keepLoaded = 0;
     if (m_aKeepLoadedVehicleModels[model - 400])
         keepLoaded = 1;
